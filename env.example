# ==============================================================================
# 📊 Google Sheets Database Configuration
# ==============================================================================
# Diambil dari file JSON Service Account Google Cloud Console (IAM & Admin -> Service Accounts)
# Pastikan Google Sheet Anda sudah di-share (Viewer/Editor) ke email service account di bawah ini!

# Email Service Account Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private Key dari Service Account (Sertakan tanda kutip dan karakter \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# ID Spreadsheet Google Sheets (Terdapat di URL Sheet: /spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your-sheet-id-here

# Nama Tab/Sheet utama database generus (Opsional, default: "Sheet1")
# Contoh: "Form Responses 1" atau "Sheet1"
GOOGLE_SHEET_NAME=Sheet1


# ==============================================================================
# 🔐 Security & Authentication Configuration
# ==============================================================================
# Secret key untuk signing JWT Session Admin (Gunakan string acak yang kuat di production)
AUTH_SECRET=antigravity-secret-key-2026-secure-default

# Secret API Token untuk otorisasi Endpoint Eksternal (/api/v1/generus/stats)
# Klien eksternal mengirim token ini via header 'x-api-key', 'Authorization', atau query '?token='
EXTERNAL_API_TOKEN=generus-api-secret-key-2025


# ==============================================================================
# 🚩 Feature Flags & Client Permissions
# ==============================================================================
# Mengontrol akses tombol aksi (Tambah, Edit, Hapus) pada antarmuka publik/dashboard
NEXT_PUBLIC_IS_ENABLE_ACTION=false
NEXT_PUBLIC_ENABLE_ADD=false
NEXT_PUBLIC_ENABLE_EDIT=false
NEXT_PUBLIC_ENABLE_DELETE=false